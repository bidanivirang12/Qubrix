# List-valued settings use JSON arrays, including cors_origins and allowed_algorithms.
QUBRIX_ENVIRONMENT=development
QUBRIX_DEBUG=false
QUBRIX_APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://qubrix_app:replace-me@localhost:5432/qubrix_dev
TEST_DATABASE_URL=postgresql+psycopg://qubrix_app:replace-me@localhost:5432/qubrix_test
RUNTIME_DATABASE_URL=postgresql+psycopg://qubrix_runtime:replace-me@localhost:5432/qubrix_dev
RUNTIME_TEST_DATABASE_URL=postgresql+psycopg://qubrix_runtime:replace-me@localhost:5432/qubrix_test
QUBRIX_OIDC_PROVIDER=development
QUBRIX_OIDC_ISSUER=
QUBRIX_OIDC_AUDIENCE=
QUBRIX_JWKS_URL=
QUBRIX_JWKS_CACHE_LIFETIME_SECONDS=300
QUBRIX_CLOCK_SKEW_LEEWAY_SECONDS=60
QUBRIX_ALLOWED_ALGORITHMS=["RS256","ES256"]
QUBRIX_KEY_PROVIDER=software
QUBRIX_CORS_ORIGINS=[]
QUBRIX_CORS_ALLOW_CREDENTIALS=false
QUBRIX_REQUEST_BODY_MAX_BYTES=1048576
QUBRIX_REPLAY_FRESHNESS_WINDOW_SECONDS=2592000
QUBRIX_TIMESTAMP_SKEW_TOLERANCE_SECONDS=300
QUBRIX_SERVICE_EVENTS_PER_MINUTE=60
QUBRIX_CRYPTO_REQUESTS_PER_MINUTE=10
QUBRIX_HUMAN_READS_PER_MINUTE=120
QUBRIX_HUMAN_WRITES_PER_MINUTE=30
QUBRIX_DB_POOL_SIZE=5
QUBRIX_DB_MAX_OVERFLOW=5
QUBRIX_DB_STATEMENT_TIMEOUT_MS=5000
