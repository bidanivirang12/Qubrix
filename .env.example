QUBRIX_ENVIRONMENT=development
QUBRIX_DEBUG=false
QUBRIX_APP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql+psycopg://qubrix_app:REPLACE_ME@localhost:5432/qubrix_dev
TEST_DATABASE_URL=postgresql+psycopg://qubrix_app:REPLACE_ME@localhost:5432/qubrix_test
RUNTIME_DATABASE_URL=postgresql+psycopg://qubrix_runtime:REPLACE_ME@localhost:5432/qubrix_dev
RUNTIME_TEST_DATABASE_URL=postgresql+psycopg://qubrix_runtime:REPLACE_ME@localhost:5432/qubrix_test
QUBRIX_OIDC_PROVIDER=development
QUBRIX_OIDC_ISSUER=
QUBRIX_OIDC_AUDIENCE=
QUBRIX_KEY_PROVIDER=software
QUBRIX_CORS_ORIGINS=[]
QUBRIX_CORS_ALLOW_CREDENTIALS=false
QUBRIX_DB_POOL_SIZE=5
QUBRIX_DB_MAX_OVERFLOW=5
QUBRIX_DB_STATEMENT_TIMEOUT_MS=5000
